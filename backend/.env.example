# 小米 MiMo Token Plan（中国集群）
# 本地使用：在 .env 中填写密钥；不要把真实密钥写进 .env.example。
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# API 模型 ID 使用小写。核心分析用 Pro；默认、辅助章节和轻任务用 Flash。
LLM_MODEL=mimo-v2.6-flash
LLM_MODEL_CORE=mimo-v2.6-pro
LLM_MODEL_AUX=mimo-v2.6-flash
LLM_MODEL_FAST=mimo-v2.6-flash
LLM_TIMEOUT=180
LLM_MAX_RETRIES=1

# UltraSpeed 备选：mimo-v2.6-pro-ultraspeed
# 当前 Token Plan 不包含 UltraSpeed。若改用按量付费 API，必须同时换成
# LLM_BASE_URL=https://api.xiaomimimo.com/v1 和与该服务匹配的 API Key，
# 再将 LLM_MODEL_CORE 改为 mimo-v2.6-pro-ultraspeed。不会自动切换服务。

# 联网调研需要博查搜索密钥；仅启动页面/后端或验证模型不需要它。
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1
SEARCH_TIMEOUT=30

# 可选配置
DOUYIN_COOKIE=
BILIBILI_COOKIE=
XHS_COOKIE=
APP_HOST=127.0.0.1
APP_PORT=8010
FRONTEND_ORIGIN=http://localhost:3400
ENABLE_DEMO_FALLBACK=false
